# Required in production: generate a unique random signing key with at least 32 characters.
VISIONAI_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required in production over HTTPS so the session cookie is sent securely.
VISIONAI_COOKIE_SECURE=true

# Optional: set this to a path inside the persistent disk; defaults to backend/data/visionai.sqlite3.
VISIONAI_DATABASE_PATH=/path/to/persistent/disk/visionai.sqlite3

# Optional: override the default YOLO weights name/path (yolo11n.pt).
VISIONAI_YOLO_MODEL=/path/to/yolo/weights.pt

# Optional: override the YOLO configuration/cache directory.
YOLO_CONFIG_DIR=/path/to/persistent/disk/yolo-config

# Optional: place TorchVision's downloaded model weights cache on persistent storage.
TORCH_HOME=/path/to/persistent/disk/torch
